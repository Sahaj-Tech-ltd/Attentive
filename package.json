{
  "name": "anchor",
  "version": "1.0.0",
  "private": true,
  "description": "Anchor - Comprehensive ADHD/ADD Assessment Platform. Web-based clinical screening using validated neuropsychological instruments.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "vite": "^6.2.0",
    "vitest": "^1.6.1"
  },
  "vitest": {
    "testEnvironment": "jsdom",
    "include": [
      "src/modules/__tests__/**/*.test.js"
    ],
    "globals": true,
    "setupFiles": [
      "./src/modules/__tests__/setup.js"
    ]
  },
  "dependencies": {
    "@jspsych/plugin-html-button-response": "^2.1.0",
    "@jspsych/plugin-html-keyboard-response": "^2.1.0",
    "@jspsych/plugin-instructions": "^2.1.0",
    "@jspsych/plugin-preload": "^2.1.0",
    "@jspsych/plugin-survey-likert": "^2.1.0",
    "@jspsych/plugin-survey-multi-choice": "^2.1.0",
    "@jspsych/plugin-survey-text": "^2.1.0",
    "jspsych": "^7.3.3"
  },
  "license": "GPL-3.0"
}
